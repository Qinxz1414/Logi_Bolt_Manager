 # Global handle to hidapi
 _hidapi = None
+
+# debug: map device handles to the paths they were opened from
+_handle_paths = {}
+
+# ---------------------------------------------------------------------------
+# Windows Bolt receiver support:
+# The Logi Bolt receiver (046D:C548) exposes two HID top-level collections on
+# interface MI_02: Col01 accepts ONLY short HID++ reports (0x10, 7 bytes) and
+# Col02 accepts ONLY long HID++ reports (0x11, 20 bytes). Windows validates
+# report id + length strictly, so a single handle cannot send both. Solaar
+# expects one handle that speaks both. We therefore open both collections and
+# present a virtual handle that routes writes by report id and reads from both.
+# ---------------------------------------------------------------------------
+import itertools as _itertools
+
+_vh_counter = _itertools.count(10 ** 9)
+_virtual_handles = {}
+
+# 已关闭的真实句柄值 / 虚拟句柄 token，用于让 close() 幂等（防 solaar 失败路径双重释放）
+_closed_handles = set()
+_closed_tokens = set()
+
+
+class _BoltSplitHandle:
+    def __init__(self, short_handle, long_handle):
+        self.short_handle = short_handle
+        self.long_handle = long_handle
+        self.token = next(_vh_counter)
+
+    def __int__(self):
+        return self.token
+
+    def __bool__(self):
+        return True
+
+
+def _lookup_vh(device_handle):
+    if isinstance(device_handle, _BoltSplitHandle):
+        return device_handle
+    return _virtual_handles.get(device_handle)
+
+
+def _resolve_bolt_path(device_path: bytes):
+    """Return (short_path, long_path) if this is a Bolt receiver MI_02 collection, else None."""
+    decoded = device_path.decode("utf-8", "ignore")
+    if "VID_046D&PID_C548&MI_02&Col" not in decoded:
+        return None
+    if "Col01" in decoded:
+        short_path = device_path
+        long_path = device_path.replace(b"Col01", b"Col02").replace(b"&0000#", b"&0001#")
+    else:
+        long_path = device_path
+        short_path = device_path.replace(b"Col02", b"Col01").replace(b"&0001#", b"&0000#")
+    return short_path, long_path
 
